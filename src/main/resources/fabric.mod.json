{
  "schemaVersion": 1,
  "id": "custompets",
  "version": "${version}",
  "name": "CustomPets",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/custompets/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.reedwellarts.custompets.client.CustompetsDataGenerator"
    ],
    "main": [
      "com.reedwellarts.custompets.CustomPets"
    ],
    "client": [
